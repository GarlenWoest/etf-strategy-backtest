# Audited third-party clone: kept local and read-only, not tracked (commit hash recorded in AUDIT.md)
vendor/
.venv/
__pycache__/
*.pyc
.DS_Store
tmp/
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
results/

# weekly market brief (exempt from rule 2 for briefs/ only; never committed)
briefs/

# watchlist alerts (exempt from rule 2 for live/ only; never committed)
live/

# paper trading test (PAPER, FICTIONAL MONEY; exempt from rule 2 for paper/ only; never committed)
paper/

# private backup git database for paper/, live/, briefs/ (never pushed to this repository)
.backup.git/
